node_modules/
dist/
src-tauri/target
src-tauri/resources/*
# ...except the bundled cover artwork: 128 KB of small SVG sources that are
# content rather than build output, and without them a fresh clone ships with no
# cover art.
!src-tauri/resources/covers/bin/

# Vendored engine binaries. Over the 100 MB per-file hard limit on GitHub
# (libggml-cuda.so alone is 113 MB), and all of it is build output rather than
# source. `scripts/fetch-resources.sh` puts it back.
src-tauri/resources/*
# ...except the bundled cover artwork: 128 KB of small SVG sources that are
# content rather than build output, and without them a fresh clone ships with no
# cover art.
!src-tauri/resources/covers/

# Tauri regenerates these from tauri.conf.json.
src-tauri/gen/

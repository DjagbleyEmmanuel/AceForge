{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AceForge",
  "version": "0.4.3",
  "identifier": "app.aceforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AceForge",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "resources/runtime/*": "aceforge-runtime/",
      "resources/audiocpp/*": "audiocpp/",
      "resources/covers/*": "covers/"
    }
  }
}
